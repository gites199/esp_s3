#include <SPI.h>
#include <SD.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ST7789.h>
#include <math.h>

// GITES199 MINI CONSOLE
// ESP32-S3 DevKitC-1 N8R2
// ST7789 170x320 + SPI microSD + 6 buttons

// ---------- DISPLAY ----------
#define TFT_CS   10
#define TFT_DC   7
#define TFT_RST  5
#define TFT_BL   38
#define SCREEN_W 320
#define SCREEN_H 170

// Инициализация с правильным размером матрицы
Adafruit_ST7789 tft = Adafruit_ST7789(TFT_CS, TFT_DC, TFT_RST);

// ---------- SD CARD: shared SPI bus ----------
#define SD_CS    14
#define SD_SCK   12
#define SD_MISO  13
#define SD_MOSI  11
bool sdReady = false;

// ---------- BUTTONS (button connects GPIO to GND) ----------
#define BTN_UP     1
#define BTN_DOWN   2
#define BTN_LEFT   4
#define BTN_RIGHT  6
#define BTN_A      8
#define BTN_B      9

// ---------- RGB565 COLORS ----------
#define BLACK   0x0000
#define WHITE   0xFFFF
#define RED     0xF800
#define GREEN   0x07E0
#define BLUE    0x001F
#define YELLOW  0xFFE0
#define ORANGE  0xFD20
#define GRAY    0x8410
#define DARK    0x2104
#define PINK    0xF9B2

int brightness = 80;
int fps = 30;
int frameDelay() { return 1000 / max(1, fps); }

void setBrightness() {
  analogWrite(TFT_BL, map(brightness, 0, 100, 0, 255));
}

// ---------- BUTTON HELPERS ----------
bool key(int pin) { return digitalRead(pin) == LOW; }

bool newPress(int pin) {
  static bool previous[49] = {false};
  static unsigned long changedAt[49] = {0};
  static bool stable[49] = {false};

  bool raw = key(pin);
  if (raw != previous[pin]) {
    previous[pin] = raw;
    changedAt[pin] = millis();
  }
  if (millis() - changedAt[pin] >= 25 && stable[pin] != raw) {
    stable[pin] = raw;
    if (stable[pin]) return true;
  }
  return false;
}

void waitRelease(int pin) {
  while (key(pin)) delay(5);
  delay(25);
}

// ---------- PIXEL GUINEA-PIG START LOGO ----------
void heart(int x, int y) {
  tft.fillRect(x + 4, y, 5, 5, RED);
  tft.fillRect(x + 12, y, 5, 5, RED);
  tft.fillRect(x, y + 5, 21, 8, RED);
  tft.fillRect(x + 4, y + 13, 13, 5, RED);
  tft.fillRect(x + 8, y + 18, 5, 5, RED);
}

