int brightness = 80;
int fps = 30;
int frameDelay() { return 1000 / max(1, fps); }

void setBrightness() {
  analogWrite(TFT_BL, map(brightness, 0, 100, 0, 255));
}

// ---------- IMPROVED BUTTON DEBOUNCER ----------
bool key(int pin) { return digitalRead(pin) == LOW; }

bool newPress(int pin) {
  static bool lastState[49] = {false};
  static unsigned long lastDebounce[49] = {0};
  
  bool currentState = key(pin);
  bool pressed = false;

  if (currentState != lastState[pin]) {
    lastDebounce[pin] = millis();
  }

  if ((millis() - lastDebounce[pin]) > 20) {
    static bool confirmedState[49] = {false};
    if (currentState != confirmedState[49]) {
      confirmedState[49] = currentState;
      if (confirmedState[49] == true) {
        pressed = true;
      }
    }
  }
  lastState[pin] = currentState;
  return pressed;
}

void waitRelease(int pin) {
  while (key(pin)) delay(5);
  delay(15);
}

